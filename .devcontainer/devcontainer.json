{
  "name": "EFA Codespaces",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash scripts/setup_lean_cli.sh",
  "forwardPorts": [8000, 6333],
  "portsAttributes": {
    "8000": {
      "label": "EFA Web Application",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "6333": {
      "label": "Qdrant Dashboard",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postStartCommand": "docker compose --profile init up -d"
}
