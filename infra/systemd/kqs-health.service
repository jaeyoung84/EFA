[Unit]
Description=KQS publication health check (alerts when the expected session is not published)
Wants=docker.service
After=docker.service
OnFailure=kqs-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose -f /opt/investing-app/infra/docker/docker-compose.engine.yml --profile engine run --rm kqs-status
