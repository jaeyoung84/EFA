  "changes": [
    "kqs-publish-worker is the single installed writer: writer lock -> recorded ready quality run -> recompute -> publish -> attempt log",
    "store.publish requires a held WriterLock (non-blocking flock on <snapshot>.writer.lock) bound to the same publication DB",
    "quality evidence is read from the immutable quality DB by run_id (kqs_collection.store.read_run), not a loose JSON file",
    "immutable, separate worker attempt log with statuses published/already_published/blocked_quality/writer_busy/failed",
    "kqs-recommend is preview-only; publication flags were removed so there is one publication path"
  ],
  "contract": "kqs-recommendations/v1",
  "publication_policy": "explicit-session-expiry/v1 + krx-session-expiry/v1 + market-input-quality-gate/v1 + single-writer-lock/v1",
