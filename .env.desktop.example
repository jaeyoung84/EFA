# Docker Desktop 개인 실행 설정. 필요하면 .env.desktop으로 복사해 값만 바꾸세요.
APP_PORT=8000
MONGO_PORT=27017
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MEILI_PORT=7700
OLLAMA_PORT=11434
MONGODB_DB=jy_investing
# DART 기업 검색·재무제표 화면에 필요. https://opendart.fss.or.kr 에서 무료 발급.
# 비워두면 해당 화면만 502를 반환하고 나머지 기능은 정상 동작한다.
DART_API_KEY=
# 선택: KIND 접근이 제한된 환경의 KRX 상장법인 JSON 미러
# KRX_COMPANY_LIST_URL=https://example.com/krx/company-list.json
KRX_COMPANY_LIST_TIMEOUT_SECONDS=4
# 일봉 OHLCV 공급자 우선순위 및 Stooq 선택 매핑
MARKET_DATA_PROVIDERS=yahoo,stooq,fred
# STOOQ_SYMBOL_MAP=SPY=spy.us
# 저장 전 제외된 봉 비율이 이 값을 넘으면 다음 공급자 교차검증을 시도하고 검토 경고를 남깁니다.
MARKET_DATA_REVIEW_REJECTION_PCT=1
# Fed H.10 일일 fixing을 KRW/USD 보조 검증값으로 사용합니다. 첫 = 뒤의 값이 FRED 시리즈 ID입니다.
FRED_SERIES_MAP=KRW=X=DEXKOUS
# Yahoo 종가와 FRED New York noon fixing의 허용 최대 편차(%)
FX_CROSSCHECK_MAX_DEVIATION_PCT=3
# 최근 7일 공급자 상태 경고 기준. 최소 시도 수를 충족한 뒤 오류/거부 봉 비율을 점검합니다.
MARKET_DATA_PROVIDER_MIN_ATTEMPTS=3
MARKET_DATA_PROVIDER_MAX_ERROR_RATE_PCT=20
MARKET_DATA_PROVIDER_MAX_REJECTION_RATE_PCT=5
# 최근 평균 응답 시간이 이 값을 넘으면(최소 시도 수 충족 후) 느린 공급자로 뒤로 배치합니다.
MARKET_DATA_PROVIDER_SLOW_LATENCY_MS=5000
# 당일 평균 지연을 과거 일일 스냅샷과 비교해, 급격한 성능 저하를 조기에 경고합니다.
MARKET_DATA_PROVIDER_LATENCY_BASELINE_DAYS=7
MARKET_DATA_PROVIDER_LATENCY_MIN_BASELINE_SNAPSHOTS=3
MARKET_DATA_PROVIDER_LATENCY_REGRESSION_PCT=75
# 실제 공급자 장애 시 5→10→20분으로 늘어나는 재시도 대기 시간(최대 120분)
MARKET_DATA_PROVIDER_BACKOFF_BASE_MINUTES=5
MARKET_DATA_PROVIDER_BACKOFF_MAX_MINUTES=120
# 평일 장 마감 후 핵심 지수·보유·전략 종목 일봉을 자동으로 갱신합니다.
# 실패해도 마지막 검증 캐시는 유지되며, 홈 화면에서 최근 실행 상태를 확인할 수 있습니다.
MARKET_DATA_DAILY_REFRESH_ENABLED=true
MARKET_DATA_DAILY_REFRESH_HOUR_KST=18
MARKET_DATA_DAILY_REFRESH_MINUTE_KST=25
MARKET_DATA_REFRESH_DAYS=370
MARKET_DATA_CORE_TICKERS=^KS11,^KQ11,^GSPC,^IXIC,KRW=X
# Ubuntu-26.04 korea-quant-system 읽기 전용 상태 브리지
KQS_BRIDGE_URL=http://127.0.0.1:18100
# 후보 검토 업무 SLA이며 주문·승인과 연결되지 않습니다.
KQS_REVIEW_SLA_HOURS=4
KQS_REVIEW_DUE_SOON_MINUTES=60
KQS_OPERATIONS_ACK_SLA_HOURS=8
# 후보 사후성과 판정에 필요한 거래일별 최소 관측 수입니다. 표본이 부족하면 결과는 관측용으로만 표시됩니다.
KQS_OUTCOME_MIN_SAMPLE_SIZE=20
# 저장된 워크포워드 연구를 최신 데이터로 다시 검토해야 하는 최대 경과일입니다.
RESEARCH_REVALIDATION_MAX_AGE_DAYS=31
# 주문 실행 안전 설정. 기본값은 모의 주문만 허용하며, 현재 배포본에는 실거래 어댑터가 없습니다.
EXECUTION_MODE=paper
EXECUTION_GLOBAL_KILL_SWITCH=false
LIVE_TRADING_ENABLED=false
LIVE_TRADING_KILL_SWITCH=true
# 계약/장애 처리 테스트용 로컬 어댑터입니다. 실거래 API·계좌에는 연결하지 않습니다.
BROKER_ADAPTER=
BROKER_SANDBOX_ENABLED=false
# 운영 환경에서는 원문 키 대신 Secret Manager가 주입한 환경변수를 사용합니다.
BROKER_SECRET_SOURCE=none
# 외부 Secret Manager 참조명만 기록합니다. 값이나 URI에 자격증명을 넣지 마세요.
# BROKER_API_KEY_REF=
# BROKER_API_SECRET_REF=
# BROKER_ACCOUNT_ID_REF=
# 쉼표로 구분한 운영자 이메일. 준비 검토·전략 버전 승인 기록에만 쓰이며 실거래 권한을 만들지 않습니다.
# EXECUTION_OPERATOR_EMAILS=

# 레버리지 DCA 자동 모의매매를 특정 계정만 쓰도록 잠글 때 설정합니다(쉼표 구분).
# 비워두면 로그인한 모든 계정이 접근 가능합니다.
# LEVERAGE_DCA_ALLOWED_EMAILS=
# 선택: 승인 고정된 전략만 새 모의 주문 제안을 허용하고, 활성 재검토 경고가 있으면 차단합니다.
# PAPER_ORDER_REQUIRE_PROMOTION_APPROVAL=false
# PAPER_ORDER_BLOCK_PROMOTION_ALERTS=true
# 장기 모의운용 뒤 실거래 검토 후보 분류 기준입니다. 실거래 권한을 만들지 않습니다.
# PAPER_LIVE_REVIEW_MIN_TRADING_DAYS=20
# PAPER_LIVE_REVIEW_MIN_ORDER_DECISIONS=3
# PAPER_LIVE_REVIEW_MAX_MDD_PCT=10
# PAPER_LIVE_REVIEW_MAX_PERFORMANCE_GAP_PCT=10
# PAPER_LIVE_REVIEW_MAX_BLOCK_RATE_PCT=20
# PAPER_LIVE_REVIEW_MAX_REDUCED_RATE_PCT=20
# PAPER_LIVE_REVIEW_MAX_SANDBOX_REJECTION_RATE_PCT=10
# 실거래 어댑터를 별도 설치·검토하기 전에는 아래 값을 넣지 마세요.
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=

# 선택: 레버리지 DCA 전략(UPRO/SOXL)을 Alpaca Paper Trading API로 체결할 때만 설정합니다.
# 반드시 Alpaca의 Paper 전용 키를 사용하세요. https://paper-api.alpaca.markets 만 호출하며
# 비워두면 화면에서 토글을 켜도 자체 모의 체결 엔진으로 동작합니다.
# ALPACA_PAPER_API_KEY=
# ALPACA_PAPER_API_SECRET=
