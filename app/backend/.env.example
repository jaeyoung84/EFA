# 로컬에서 `uvicorn app.backend.main:app --reload`로 실행할 때 사용하는 예시입니다.
# Docker Compose 환경에서는 저장소 루트의 .env 값을 사용합니다.

# 사용자·보유자산·KQS 판단 원장·전략 저장소(MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=investment_db

# 네이버 로그인. Client Secret은 저장소에 커밋하지 말고 실제 환경파일/Secret Manager에만 넣으세요.
# Callback URL은 네이버 애플리케이션에 등록한 값과 글자 단위로 같아야 합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/auth/naver/callback
# 이메일·비밀번호 가입/로그인은 종료했습니다(기본 비활성). 테스트·로컬 점검용으로만 true로 켭니다.
LEGACY_EMAIL_SIGNUP_ENABLED=false

# OpenDART 기업·재무 공시 조회용 인증키 (미설정 시 DART API는 503을 반환)
DART_API_KEY=

# 국내 종목명 검색은 기본적으로 KIND 상장법인 목록을 직접 사용합니다.
# AWS 등 KIND 접근이 제한된 환경에서는 같은 필드(name/code/market)의 JSON 미러 URL을 지정하세요.
# KRX_COMPANY_LIST_URL=https://example.com/krx/company-list.json
KRX_COMPANY_LIST_TIMEOUT_SECONDS=4

# 일봉 OHLCV 수집 공급자 우선순위. Stooq는 미국 일반 주식의 보조 공급자이며,
# 한국 지수 등은 아래 매핑을 명시해야 합니다. 마지막 검증 통과 데이터는 MongoDB에서 폴백됩니다.
MARKET_DATA_PROVIDERS=yahoo,stooq,fred
# STOOQ_SYMBOL_MAP=^KS11=kospi,005930.KS=005930.kr
# 저장 전 제외된 봉 비율이 이 값을 넘으면 보조 공급자 교차검증을 시도합니다.
MARKET_DATA_REVIEW_REJECTION_PCT=1
# Fed H.10 일일 fixing의 KRW/USD 시리즈. Yahoo 종가 교차검증에만 사용합니다.
FRED_SERIES_MAP=KRW=X=DEXKOUS
FX_CROSSCHECK_MAX_DEVIATION_PCT=3
# 최근 7일 공급자 상태 경고 기준
MARKET_DATA_PROVIDER_MIN_ATTEMPTS=3
MARKET_DATA_PROVIDER_MAX_ERROR_RATE_PCT=20
MARKET_DATA_PROVIDER_MAX_REJECTION_RATE_PCT=5
# 최근 평균 응답 시간이 이 값을 넘으면(최소 시도 수 충족 후) 느린 공급자로 뒤로 배치합니다.
MARKET_DATA_PROVIDER_SLOW_LATENCY_MS=5000
MARKET_DATA_PROVIDER_LATENCY_BASELINE_DAYS=7
MARKET_DATA_PROVIDER_LATENCY_MIN_BASELINE_SNAPSHOTS=3
MARKET_DATA_PROVIDER_LATENCY_REGRESSION_PCT=75
MARKET_DATA_PROVIDER_BACKOFF_BASE_MINUTES=5
MARKET_DATA_PROVIDER_BACKOFF_MAX_MINUTES=120
# 평일 장 마감 후 핵심 지수·보유·전략 종목의 일봉을 자동 수집합니다.
# 공급자 장애 시 마지막 검증 캐시를 유지하고, 최근 실행 상태를 홈 화면에 표시합니다.
MARKET_DATA_DAILY_REFRESH_ENABLED=true
MARKET_DATA_DAILY_REFRESH_HOUR_KST=18
MARKET_DATA_DAILY_REFRESH_MINUTE_KST=25
MARKET_DATA_REFRESH_DAYS=370
MARKET_DATA_CORE_TICKERS=^KS11,^KQ11,^GSPC,^IXIC,KRW=X

# 주문 실행 안전 설정. 현재 코드는 실거래 주문 전송 어댑터를 포함하지 않아 paper-only입니다.
EXECUTION_MODE=paper
EXECUTION_GLOBAL_KILL_SWITCH=false
LIVE_TRADING_ENABLED=false
LIVE_TRADING_KILL_SWITCH=true
# 로컬 계약 테스트 전용(실주문 전송 없음)
BROKER_ADAPTER=
BROKER_SANDBOX_ENABLED=false
BROKER_SECRET_SOURCE=none
# BROKER_API_KEY_REF=
# BROKER_API_SECRET_REF=
# BROKER_ACCOUNT_ID_REF=
# EXECUTION_OPERATOR_EMAILS=

# 레버리지 DCA 자동 모의매매를 특정 계정만 쓰도록 잠글 때 설정합니다(쉼표 구분).
# 비워두면 로그인한 모든 계정이 접근 가능합니다.
# LEVERAGE_DCA_ALLOWED_EMAILS=
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCOUNT_ID=

# 선택 사항: 레버리지 DCA 전략(UPRO/SOXL)을 Alpaca Paper Trading API로 체결할 때만 설정합니다.
# 반드시 Alpaca의 Paper 전용 키를 사용하세요 — 이 프로젝트는 Alpaca 실거래(live) 엔드포인트를
# 호출하지 않으며, https://paper-api.alpaca.markets 만 사용합니다. 비워 두면 사용자가
# "Alpaca 페이퍼 브로커로 체결하기"를 켜도 자체 모의 체결 엔진으로 동작합니다.
# ALPACA_PAPER_API_KEY=
# ALPACA_PAPER_API_SECRET=

# 레버리지 DCA 운영자 계정(이메일). 설정하면 이 계정만 설정 변경·즉시 실행·기록 초기화를 할 수 있고,
# 다른 로그인 계정은 운영자의 현황·포지션·체결 내역을 읽기 전용으로 모니터링한다. 비우면 계정별로 각자 관리한다.
LEVERAGE_DCA_OWNER_EMAIL=
